# GA4 measurement ID. Without this set, all GA4 script injection and event tracking is a no-op
# (see lib/analytics.js) — the site still builds and runs fine with it unset.
#
# Recommendation: reuse the SAME GA4 measurement ID the main PitchLabs app uses (see that repo's
# NEXT_PUBLIC_GA_ID), not a separate property — that's what lets blog_cta_click events be compared
# against direct-traffic conversions inside one GA4 property instead of two disconnected ones.
#
# Set this in Vercel project settings (this Learn site is deployed as its own Vercel project) —
# not something this repo can configure on its own.
NEXT_PUBLIC_GA_ID=

# Where "Build Sessions"/CTA links point. Omit to fall back to production (usepitchlabs.com).
# For local dev, point at the main PitchLabs app's own dev server (run separately, default port
# 3000) instead — this repo's own dev server should then run on a different port (see package.json
# "dev" script / .claude/launch.json) so the two can run side by side.
NEXT_PUBLIC_APP_URL=http://localhost:3000
